# Copy to .env and replace all three placeholders before starting.
APP_ENV=development
DEMO_AUTH_ENABLED=true
POSTGRES_USER=repopilot
POSTGRES_DB=repopilot
POSTGRES_PASSWORD=replace-with-random-hex-password
GITHUB_WEBHOOK_SECRET=replace-with-random-secret-at-least-32-characters
DEMO_API_TOKEN=replace-with-random-token-at-least-32-characters
# Compose builds DATABASE_URL from the PostgreSQL settings. Use URL-safe hex passwords.
# For host-based API development set DATABASE_URL and REDIS_URL separately.

# Optional GitHub App user sign-in. Register a fixed callback at /api/auth/callback.
GITHUB_OAUTH_ENABLED=false
GITHUB_APP_ID=0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/callback
WEB_ORIGIN=http://localhost:3000
# Semantic retrieval is opt-in. Fake vectors are for development mechanics only.
EMBEDDING_PROVIDER=disabled
EMBEDDING_DIMENSIONS=32
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_ALLOW_PAID=false
